{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OrderSchema",
  "type": "object",
  "required": ["id", "user_id", "items", "subtotal", "tax", "total", "status", "shipping_address", "created_at"],
  "properties": {
    "id": { "type": "string" },
    "user_id": { "type": "string" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["product_id", "title", "price", "quantity", "line_total"],
        "properties": {
          "product_id": { "type": "string" },
          "title": { "type": "string" },
          "price": { "type": "number" },
          "quantity": { "type": "integer", "minimum": 1 },
          "line_total": { "type": "number" }
        }
      }
    },
    "subtotal": { "type": "number" },
    "tax": { "type": "number" },
    "total": { "type": "number" },
    "status": { "type": "string", "enum": ["PENDING", "CONFIRMED", "SHIPPED", "DELIVERED", "CANCELLED"] },
    "shipping_address": { "type": "string" },
    "created_at": { "type": "string" }
  },
  "additionalProperties": false
}
